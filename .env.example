# Loxep bootstrap configuration — copy to .env and fill in real values.
# Canonical reference: docs → Architecture → Configuration & Secrets
# ("Bootstrap environment reference"). Any [_FILE]-capable variable may be
# supplied as <VAR>_FILE pointing at a mounted secret file instead.

# --- Compose stack ----------------------------------------------------------

# Required by compose.yml — password for the bundled PostgreSQL service.
# Use URL-safe characters (it is interpolated into LOXEP_DATABASE_URL).
POSTGRES_PASSWORD=change-me

# --- Required in every mode -------------------------------------------------

# postgres:// / postgresql:// connection URL. The default compose.yml wires
# this to the bundled postgres service automatically — only set it here when
# running Loxep outside the bundled stack (or to point at external PostgreSQL).
#LOXEP_DATABASE_URL=postgresql://postgres:change-me@postgres:5432/loxep

# Root encryption keyring (ADR-0019): JSON with an active_version and a map of
# version -> base64-encoded 256-bit key. Generate a real key with:
#   head -c 32 /dev/urandom | base64
# then replace AAAA...= below. The placeholder is intentionally not a valid key.
LOXEP_KEYRING={"active_version":1,"keys":{"1":"REPLACE-WITH-32-BYTE-BASE64-KEY-FROM-urandom="}}

# --- Required in web/all modes ----------------------------------------------

# Canonical http(s) origin users reach Loxep at.
LOXEP_PUBLIC_ORIGIN=http://localhost:3020

# Better Auth secret, min 32 chars. Generate: head -c 32 /dev/urandom | base64
LOXEP_AUTH_SECRET=replace-with-at-least-32-random-characters

# --- Login configuration (web/all needs at least one complete group) --------

# OIDC group — all-or-none.
#LOXEP_OIDC_ISSUER=https://id.example.com
#LOXEP_OIDC_CLIENT_ID=loxep
#LOXEP_OIDC_CLIENT_SECRET=change-me

# SMTP group (magic-link login) — all-or-none. smtp:// or smtps:// URL.
LOXEP_SMTP_URL=smtp://mail.example.com:587
LOXEP_SMTP_FROM=loxep@example.com

# --- Optional ----------------------------------------------------------------

# all | web | worker (default: all). Compose default stack runs `all`.
#LOXEP_MODE=all

# HTTP/health port (default: 3020). compose.yml publishes 3020:3020.
#LOXEP_PORT=3020

# First-admin bootstrap identity — the first matching login becomes admin.
#LOXEP_BOOTSTRAP_ADMIN_EMAIL=you@example.com

# Local media storage root (default: ./data/media). compose.yml sets this to
# /data/media on a named volume.
#LOXEP_MEDIA_ROOT=/data/media

# fatal|error|warn|info|debug|trace (default: info)
#LOXEP_LOG_LEVEL=info

# --- Optional rustfs profile (docker compose --profile rustfs up -d) --------

# Credentials for the RustFS companion; also used when configuring the S3
# storage backend in-app. Change from the defaults for any real deployment.
#RUSTFS_ACCESS_KEY=rustfsadmin
#RUSTFS_SECRET_KEY=rustfsadmin
